# Copy to .env and set your own password. Never commit .env.
APP_PASSWORD=change-me-to-something-long

# Port on server1 that this app listens on. Pick one that nothing else uses.
HOST_PORT=3100
# 0.0.0.0 = reachable from the network. Use 127.0.0.1 if only a reverse proxy on server1 should reach it.
BIND_ADDRESS=0.0.0.0

COOKIE_SECURE=false
TRUST_PROXY=false
