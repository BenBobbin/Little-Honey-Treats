# Copy to .env and set your own password. Never commit .env.
# Use letters and numbers only: symbols such as $ and # break the .env file.
APP_PASSWORD=delilahizabelabobbin

# Port on this machine that the app listens on. Pick one that nothing else uses.
HOST_PORT=3100
# 0.0.0.0 = reachable from the network. Use 127.0.0.1 once the tunnel works,
# so the app can only be reached through Cloudflare.
BIND_ADDRESS=0.0.0.0

# Leave these as they are until the https address works, then set both to true.
COOKIE_SECURE=false
TRUST_PROXY=false

# Cloudflare Tunnel. Paste the tunnel token from Cloudflare and uncomment both lines.
# The token is a credential: keep it only in your own .env file.
#TUNNEL_TOKEN=
#COMPOSE_PROFILES=tunnel